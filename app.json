{
  "expo": {
    "name": "Accord Mobile V4",
    "slug": "accord-mobile-v4",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "accordmobilev4",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "blockedPermissions": ["android.permission.RECORD_AUDIO"],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Ilovani ochish uchun Face ID’dan foydalanishga ruxsat bering."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Chatda so‘nggi rasmlarni ko‘rsatish va profil uchun rasm tanlashga ruxsat bering.",
          "microphonePermission": "Chatda video yozish uchun mikrofondan foydalanishga ruxsat bering."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Chatda so‘nggi rasmlarni ko‘rsatish va profil uchun rasm tanlashga ruxsat bering.",
          "savePhotosPermission": false,
          "granularPermissions": ["photo"]
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Chat va profil uchun suratga olish hamda QR kodlarni skanerlash uchun kameraga ruxsat bering."
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
